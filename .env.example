# ==============================================================================
# Kastamonu Üniversitesi Öğrenci Asistanı (Swiss Tool) - Ortam Değişkenleri (.env)
# ==============================================================================
# Bu dosyayı ".env" adıyla kopyalayıp kendi bilgilerinizi girin.
# DİKKAT: ".env" dosyasını asla herkese açık bir yere veya GitHub'a yüklemeyin!

# --- Zorunlu Ayarlar ---

# ÜBYS kullanıcı adınız (genellikle öğrenci numaranız; alternatif adı: OGRENCI_NO)
UBYS_USERNAME=

# ÜBYS şifreniz (alternatif adı: SIFRE)
UBYS_PASSWORD=

# @BotFather üzerinden aldığınız Telegram Bot Token'ı (alternatif adı: BOT_TOKEN)
TELEGRAM_BOT_TOKEN=

# Bildirimlerin gönderileceği Telegram Chat ID (alternatif adı: CHAT_ID)
# Birden fazla hesaba göndermek için virgülle ayırabilirsiniz: 123456789,987654321
TELEGRAM_CHAT_ID=

# --- Modül Açma / Kapatma ---

ENABLE_GRADES=true
ENABLE_DINING=true
ENABLE_CALENDAR=true

# --- ÜBYS Not Takibi Ayarları ---

UBYS_BASE_URL=https://ubys.kastamonu.edu.tr
UBYS_USER_GROUP_ID=
ALL_SEMESTERS=false
FETCH_CLASS_DETAILS=true
REQUEST_DELAY_SECONDS=0.7
CHECK_INTERVAL_MINUTES=20
NOTIFY_ON_FIRST_RUN=true
ALERT_AFTER_CONSECUTIVE_ERRORS=3

# --- Durum Saklama (Yerel Dosya veya Gizli GitHub Gist) ---

STATE_FILE=data/grades_state.json

# Public GitHub Repoları İçin: Durum dosyasını gizli Gist içinde saklar
GIST_ID=
GIST_TOKEN=
GIST_FILENAME=grades_state.json

# --- Yemekhane Menüsü Ayarları (SKS) ---

SKS_URL=https://sks.kastamonu.edu.tr/
# İsteğe bağlı: SKS yerine doğrudan Google Sheets CSV/edit bağlantısı vermek isterseniz
DINING_SHEET_URL=
# Hafta içi menü bildiriminin gönderileceği minimum saat (Türkiye saati, 0-23)
DINING_NOTIFY_HOUR=8

# --- Akademik Takvim Ayarları ---

CALENDAR_URL=https://akademiktakvim.kastamonu.edu.tr/
# Birim seçenekleri: GENEL, TIP, VET, DIS, LISANSUSTU, TURIZM (veya tam birim adı)
CALENDAR_FACULTY=GENEL
# Kategori filtresi: STUDENT (çekirdek öğrenci etkinlikleri), ALL veya virgüllü liste
CALENDAR_CATEGORIES=STUDENT
# Etkinlik başlamadan kaç gün önce tek seferlik hatırlatma gönderilsin
CALENDAR_REMINDER_DAYS=7,3,1,0
# Haftalık özetlerde kaç gün ileriye bakılsın
CALENDAR_LOOKAHEAD_DAYS=30
# Günlük takvim kontrolünün yapılacağı minimum saat (Türkiye saati, 0-23)
CALENDAR_NOTIFY_HOUR=8
# Her Pazartesi haftalık devam eden & yaklaşan etkinlik özetini gönder (true/false)
CALENDAR_WEEKLY_SUMMARY=true
