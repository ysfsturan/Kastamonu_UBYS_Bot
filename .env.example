# ==============================================================================
# Kastamonu Üniversitesi ÜBYS Not Bildirim Botu - Ortam Değişkenleri (.env)
# ==============================================================================
# Bu dosyayı ".env" adıyla kopyalayıp kendi bilgilerinizi girin.
# DİKKAT: ".env" dosyasını asla herkese açık bir yere veya GitHub'a yüklemeyin!

# --- Zorunlu Ayarlar ---

# ÜBYS kullanıcı adınız (genellikle öğrenci numaranız)
UBYS_USERNAME=

# ÜBYS şifreniz
UBYS_PASSWORD=

# @BotFather üzerinden aldığınız Telegram Bot Token'ı
TELEGRAM_BOT_TOKEN=

# Bildirimlerin gönderileceği Telegram Chat ID
# Birden fazla hesaba göndermek için virgülle ayırabilirsiniz: 123456789,987654321
TELEGRAM_CHAT_ID=

# --- İsteğe Bağlı Ayarlar ---

# Kastamonu ÜBYS adresi (varsayılan: https://ubys.kastamonu.edu.tr)
UBYS_BASE_URL=https://ubys.kastamonu.edu.tr

# Hesabınızda birden fazla kullanıcı grubu varsa (örn. hem öğrenci hem personel)
# kullanılacak grup ID'si. Boş bırakılırsa otomatik olarak öğrenci grubu seçilir.
UBYS_USER_GROUP_ID=

# Notların önceki durumunun saklanacağı yerel JSON dosya yolu (GIST yoksa kullanılır)
STATE_FILE=data/grades_state.json

# (İsteğe bağlı - Public GitHub Repoları İçin Önerilen)
# Durum dosyasını repo yerine gizli (Secret) bir GitHub Gist içinde saklamak için doldurun.
GIST_ID=
GIST_TOKEN=
GIST_FILENAME=grades_state.json

# false: Yalnızca aktif/güncel dönemi takip eder (önerilen)
# true: Tüm geçmiş dönemleri de tarar
ALL_SEMESTERS=false

# true: Her dersin detay sayfasından (ClassDetail) Vize/Final/Sınıf Ortalaması bilgilerini çeker
# false: Yalnızca ana not listesi sayfasından kontrol eder
FETCH_CLASS_DETAILS=true

# Ders detay sayfaları arasındaki bekleme süresi (saniye) — sunucuyu yormamak için
REQUEST_DELAY_SECONDS=0.7

# --loop modunda kontrol sıklığı (dakika)
CHECK_INTERVAL_MINUTES=20

# İlk çalıştırmada mevcut notların özetini Telegram'a gönderir (true/false)
NOTIFY_ON_FIRST_RUN=true

# Ardışık kaç geçici ağ/sunucu hatasından sonra Telegram'a uyarı atılsın
ALERT_AFTER_CONSECUTIVE_ERRORS=3
